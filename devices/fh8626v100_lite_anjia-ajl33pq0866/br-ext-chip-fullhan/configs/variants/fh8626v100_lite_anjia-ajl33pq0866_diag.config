# Streamer-free board diagnostics.
# Build with the shared FH8626 Firmware core:
#   OPENIPC_FW_REPO=https://github.com/ArthurKoba/openipc-firmware.git
#   OPENIPC_FW_REV=work/fh8626v100
BR2_PACKAGE_ANJIA_AJL33PQ0866_TARGET_NAME="fh8626v100_lite_anjia-ajl33pq0866_diag"
BR2_PACKAGE_ANJIA_AJL33PQ0866_UPDATE_TARGET=""
# BR2_PACKAGE_DIVINUS is not set
# BR2_PACKAGE_MAJESTIC_FH8852V200_COMPAT is not set

# Diagnostic-only convenience: the stock OpenIPC ipctool wrapper downloads its
# current plugin over HTTPS, so this target deliberately carries curl/mbedTLS.
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
BR2_PACKAGE_LIBCURL_OPENIPC_MBEDTLS=y
BR2_PACKAGE_MBEDTLS_OPENIPC=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_ANJIA_AJL33PQ0866_PTZ=y
