# Majestic experimental compatibility direction.
# Normal Builder invocation selects the sibling .firmware metadata automatically:
#   ./builder.sh fh8626v100_lite_anjia-ajl33pq0866_majestic
# OPENIPC_FW_REPO / OPENIPC_FW_REV remain optional explicit bisect overrides.
BR2_PACKAGE_ANJIA_AJL33PQ0866_TARGET_NAME="fh8626v100_lite_anjia-ajl33pq0866_majestic"
BR2_PACKAGE_ANJIA_AJL33PQ0866_UPDATE_TARGET="fh8626v100_lite_anjia-ajl33pq0866_majestic"
# BR2_PACKAGE_DIVINUS is not set
BR2_PACKAGE_MAJESTIC_FH8852V200_COMPAT=y
BR2_PACKAGE_ANJIA_AJL33PQ0866_PTZ=y
