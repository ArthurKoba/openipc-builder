# ANJIA AJL33PQ0866 board-only delta.
# Generic FH8626 architecture/toolchain/kernel/filesystem selections come from
# the Firmware defconfig named in the sibling firmware-base file.

# Apply only the retail-board kernel delta on top of the generic FH8626 config.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/anjia-ajl33pq0866/kernel.config"

# The camera has a removable FAT32 microSD slot. Keep an offline checker in the
# image so an unclean card can be diagnosed without embedding filesystem policy
# into the generic FH8626 core.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y

# Device-owned executable hardware backends: PTZ, lens and illumination.
BR2_PACKAGE_ANJIA_AJL33PQ0866_BOARD_SUPPORT=y

# The soldered USB adapter is 0bda:f179 / RTL8188FU.
BR2_PACKAGE_RTL8188FU_OPENIPC=y
