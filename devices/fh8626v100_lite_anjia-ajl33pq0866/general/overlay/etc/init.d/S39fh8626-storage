#!/bin/sh

device=/dev/mmcblk0p1
mountpoint=/mnt/mmcblk0p1
hook=/usr/share/openipc/automount-hook

mounted()
{
	grep -qs "^$device $mountpoint " /proc/mounts
}

case "${1:-start}" in
	start)
		# S38mdev normally mounted the card already. Replaying the board hook is
		# harmless and also repairs the directory after a rootfs-only update.
		mounted && "$hook" add "$device" "$mountpoint"
		;;
	stop)
		if mounted; then
			"$hook" remove "$device" "$mountpoint"
			umount "$mountpoint"
		fi
		;;
	restart) "$0" stop; "$0" start ;;
	*) echo "usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
