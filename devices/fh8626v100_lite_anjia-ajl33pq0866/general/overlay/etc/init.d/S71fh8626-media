#!/bin/sh

DEFAULTS=/etc/default/fh8626-media
OWNER_PID=/var/run/fh8626-media-owner.pid
DIVINUS_PID=/var/run/divinus.pid
CONTROL_FIFO=/tmp/fh8626_ctl

[ -r "$DEFAULTS" ] && . "$DEFAULTS"

FH8626_STREAM_SOCKET="${FH8626_STREAM_SOCKET:-/run/fh8626-divinus.sock}"
FH8626_ISP_PROFILE="${FH8626_ISP_PROFILE:-day}"
FH8626_OWNER_LOG="${FH8626_OWNER_LOG:-/var/log/fh8626-media-owner.log}"
DIVINUS_LOG="${DIVINUS_LOG:-/var/log/divinus.log}"
FH8626_NATIVE_HAL="${FH8626_NATIVE_HAL:-1}"

pid_is_live()
{
	[ -r "$1" ] || return 1
	pid="$(cat "$1" 2>/dev/null)"
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

wait_for_path()
{
	path="$1"
	count=0
	while [ ! -e "$path" ] && [ "$count" -lt 100 ]; do
		sleep 0.05
		count=$((count + 1))
	done
	[ -e "$path" ]
}

wait_for_media_devices()
{
	count=0
	while [ "$count" -lt 300 ]; do
		if [ -c /dev/vmm_userdev ] && [ -c /dev/media_process ] && \
		   [ -c /dev/isp ] && [ -c /dev/pae ] && \
		   [ -c /dev/gpiowave8 ]; then
			return 0
		fi
		sleep 0.05
		count=$((count + 1))
	done
	echo "ERROR: FH8626 media devices were not ready after 15 seconds" >&2
	return 1
}

start_owner()
{
	if pid_is_live "$OWNER_PID"; then
		echo "fh8626-media-owner already running"
		return 0
	fi
	wait_for_media_devices || return 1
	rm -f "$OWNER_PID" "$CONTROL_FIFO" "$FH8626_STREAM_SOCKET"
	FH8626_STREAM_SOCKET="$FH8626_STREAM_SOCKET" \
	FH8626_ISP_PROFILE="$FH8626_ISP_PROFILE" \
		/usr/sbin/fh8626-media-owner >>"$FH8626_OWNER_LOG" 2>&1 &
	echo "$!" > "$OWNER_PID"
	if ! wait_for_path "$CONTROL_FIFO" || ! wait_for_path "$FH8626_STREAM_SOCKET"; then
		echo "ERROR: fh8626-media-owner did not initialize" >&2
		return 1
	fi
	echo run > "$CONTROL_FIFO"
}

start_divinus()
{
	if pid_is_live "$DIVINUS_PID"; then
		echo "divinus already running"
		return 0
	fi
	rm -f "$DIVINUS_PID"
	/usr/bin/divinus >>"$DIVINUS_LOG" 2>&1 &
	echo "$!" > "$DIVINUS_PID"
}

start()
{
	echo "Starting FH8626 native HAL and Divinus"
	if [ ! -c /dev/vmm_userdev ] && [ -r /sys/class/misc/vmm_userdev/dev ]; then
		devno="$(cat /sys/class/misc/vmm_userdev/dev)"
		major="${devno%:*}"
		minor="${devno#*:}"
		rm -f /dev/vmm_userdev
		mknod /dev/vmm_userdev c "$major" "$minor"
		chmod 0660 /dev/vmm_userdev
	fi
	/usr/sbin/fh-anjia-ajl33pq0866-media-start
	# Match the validated owner startup: establish a known wide sensor target
	# before the sensor library is initialized by the native HAL.
	if [ -x /usr/sbin/fh8626-lens ]; then
		/usr/sbin/fh8626-lens set wide ||
			echo "WARNING: failed to select the default wide lens" >&2
	fi
	if [ "$FH8626_NATIVE_HAL" = "0" ]; then
		if ! start_owner; then
			echo "WARNING: owner unavailable; starting Divinus diagnostics anyway" >&2
		fi
	else
		wait_for_media_devices || echo "WARNING: native HAL devices are not ready" >&2
	fi
	start_divinus
}

stop()
{
	echo "Stopping Divinus and FH8626 media owner"
	if pid_is_live "$DIVINUS_PID"; then
		wget -q -O /dev/null 'http://127.0.0.1:18080/api/record?stop=1' 2>/dev/null || true
		sync
		# Divinus currently restarts after SIGTERM; use SIGKILL only after the
		# recorder has closed the current MP4 through its local API.
		kill -9 "$(cat "$DIVINUS_PID")" 2>/dev/null || true
	fi
	rm -f "$DIVINUS_PID"
	if [ "$FH8626_NATIVE_HAL" = "0" ] && [ -p "$CONTROL_FIFO" ]; then
		echo shutdown > "$CONTROL_FIFO" 2>/dev/null || true
	fi
	if [ "$FH8626_NATIVE_HAL" = "0" ] && pid_is_live "$OWNER_PID"; then
		count=0
		while pid_is_live "$OWNER_PID" && [ "$count" -lt 40 ]; do
			sleep 0.05
			count=$((count + 1))
		done
		pid_is_live "$OWNER_PID" && kill -9 "$(cat "$OWNER_PID")" 2>/dev/null || true
	fi
	rm -f "$OWNER_PID" "$CONTROL_FIFO" "$FH8626_STREAM_SOCKET"
}

case "${1:-start}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
