#!/bin/sh

# An initramfs does not receive the automatic devtmpfs mount performed for a
# conventional root filesystem. Populate the essential nodes before any
# OpenIPC init script redirects to /dev/null or reads /dev/urandom.
mountpoint -q /dev || \
	mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev 2>/dev/null || \
	mount -t tmpfs -o mode=0755,nosuid tmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/shm
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -c /dev/zero ] || mknod -m 666 /dev/zero c 1 5
[ -c /dev/random ] || mknod -m 666 /dev/random c 1 8
[ -c /dev/urandom ] || mknod -m 666 /dev/urandom c 1 9
[ -c /dev/mem ] || mknod -m 660 /dev/mem c 1 1
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s
