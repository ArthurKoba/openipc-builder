#!/bin/sh
set -eu

check_media_devices()
{
	missing=0
	for device in /dev/vmm_userdev /dev/media_process /dev/isp /dev/pae; do
		if [ ! -c "$device" ]; then
			echo "ERROR: media module did not create $device" >&2
			missing=1
		fi
	done
	return "$missing"
}

if grep -q '^vmm ' /proc/modules; then
	if check_media_devices; then
		echo "FH media modules already loaded"
		exit 0
	fi
	echo "ERROR: media modules are only partially loaded; reboot before retrying" >&2
	exit 1
fi

echo "Loading FH8626 media modules..."
MODULE_DIR=/lib/modules/4.9.129/extra
insmod "$MODULE_DIR/vmm.ko" 'mmz=anonymous,0,0xa2700000,25088K' anony=1
insmod "$MODULE_DIR/xbus_rpc.ko" fn=/lib/firmware/rtthread_arc.bin fa=0xbff80000
insmod "$MODULE_DIR/media_process.ko"
insmod "$MODULE_DIR/isp.ko"
insmod "$MODULE_DIR/enc.ko"
insmod "$MODULE_DIR/jpeg.ko"
insmod "$MODULE_DIR/bgm.ko"
insmod "$MODULE_DIR/gpio_wave.ko" GW_TIMER_INTERVAL=100
mdev -s
if [ ! -c /dev/gpiowave8 ]; then
	mknod /dev/gpiowave8 c 10 49
	chmod 0660 /dev/gpiowave8
fi
check_media_devices
echo "FH8626 media modules loaded"
