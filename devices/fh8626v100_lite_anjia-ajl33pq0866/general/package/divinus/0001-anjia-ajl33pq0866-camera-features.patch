+static int parse_int_parameter(const char *text, int *value) {
+    char *end;
+    long parsed;
+
+    if (!text || !*text || !value) return -EINVAL;
+    errno = 0;
+    parsed = strtol(text, &end, 10);
+    if (errno || end == text || *end || parsed < INT_MIN || parsed > INT_MAX)
+        return -EINVAL;
+    *value = (int)parsed;
+    return 0;
+}
