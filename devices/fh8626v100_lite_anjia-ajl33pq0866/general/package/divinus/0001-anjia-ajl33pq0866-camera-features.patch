+int fh_isp_runtime_tick_with_awb_hook(struct fh_isp_runtime *rt,
+                                      fh_isp_runtime_awb_hook_fn hook,
+                                      void *opaque)
+{
+    return fh_isp_runtime_tick_with_control_hooks(rt, NULL, NULL, hook, opaque);
+}
