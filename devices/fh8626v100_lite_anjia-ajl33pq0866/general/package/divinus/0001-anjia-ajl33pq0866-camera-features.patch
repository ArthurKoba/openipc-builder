+static int kernel_capture_awb_stats(struct fh8626_kernel *k)
+{
+    uint8_t first[0x90], second[0x90];
+    volatile uint8_t *stats_base;
+    unsigned i;
+    uint32_t hash = 2166136261u;
+
+    /* 6905 selects the completed runtime-context bank only.  The validated
+     * owner keeps the AWB/E2 provider at the fixed root+0x48
+     * (isp_cfg+0x1487b8); reading +0x48 from the selected context bank makes
+     * the 0x21270 completion alternate point at an unrelated block. */
+    if (!k || !k->isp_cfg.virt || k->isp_cfg.size <
+        0x1487b8u + sizeof(first))
+        return -ERANGE;
+    stats_base = (volatile uint8_t *)(uintptr_t)k->isp_cfg.virt + 0x1487b8u;
+    memcpy(first, (const void *)(uintptr_t)stats_base,
+           sizeof(first));
+    __sync_synchronize();
+    memcpy(second, (const void *)(uintptr_t)stats_base,
+           sizeof(second));
+    if (memcmp(first, second, sizeof(first)))
+        return -EAGAIN;
+    for (i = 0; i < sizeof(first); ++i)
+        hash = (hash ^ first[i]) * 16777619u;
+    memcpy(k->e2_stats, first, sizeof(first));
+    (void)hash;
+    if (++k->e2_stats_epoch == 0u)
+        k->e2_stats_epoch = 1u;
+    k->e2_stats_valid = 1;
+    return 0;
+}
