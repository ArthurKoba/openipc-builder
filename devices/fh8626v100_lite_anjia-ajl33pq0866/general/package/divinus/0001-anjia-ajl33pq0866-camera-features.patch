+    if (!file)
+        return -errno;
+    rc = fprintf(file, "nr3d_off\n") < 0 ? -EIO : 0;
+    if (fclose(file) && !rc)
+        rc = -errno;
+    if (rc)
+        return rc;
+    memset(&cfg, 0, sizeof(cfg));
+    rc = call_ioctl(k->isp_fd, FH8626_ISP_NR3D_QUERY, &cfg);
+    if (rc)
+        return rc;
+    if (cfg.mode != 0u)
+        return -EIO;
+    fh_isp_runtime_set_nr3d_enabled(&k->isp_runtime, 0);
+    return 0;
+}
