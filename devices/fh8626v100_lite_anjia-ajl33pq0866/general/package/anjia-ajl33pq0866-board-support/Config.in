config BR2_PACKAGE_ANJIA_AJL33PQ0866_BOARD_SUPPORT
	bool "anjia-ajl33pq0866-board-support"
	depends on BR2_arm
	help
	  Device-specific hardware backends for the ANJIA AJL33PQ0866 camera
	  with Fullhan FH8626V100.

	  Provides a stateless /dev/fh_pwm pan/tilt backend compatible with the
	  standard OpenIPC gpio-motors relative-move interface, plus an independent
	  low-level GPIO4/GPIO14 WIDE/TELE selector.

	  The package deliberately does not calibrate or move PTZ at boot and does
	  not persist inferred motor coordinates. Higher-level lens/media policy
	  remains owned by the selected runtime.

config BR2_PACKAGE_ANJIA_AJL33PQ0866_TARGET_NAME
	string
	default "fh8626v100_lite_anjia-ajl33pq0866"
	depends on BR2_PACKAGE_ANJIA_AJL33PQ0866_BOARD_SUPPORT
	help
	  Exact Builder target name embedded into the image for device-scoped
	  update identity. Runtime direction defconfigs override this when needed.
