#!/bin/sh

# OpenIPC relative motor interface. FH8626 movement timing comes from the
# hardware-PWM board parameters; DELAY_MS is accepted only for compatibility
# with the standard gpio-motors command signature.
if [ "$#" -ne 3 ]; then
    echo "usage: gpio-motors PAN_STEPS TILT_STEPS DELAY_MS" >&2
    exit 2
fi

exec /usr/sbin/fh8626-ptz move "$1" "$2"
